@page
@model HomeModel
@{
    ViewData["Title"] = "Home";
    var selectedId = Model.SelectedFolderId;
}

<div class="home-page-background">
    <video class="home-background-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
        <source src="~/videos/katana-background.mp4" type="video/mp4" />
    </video>
    <div class="home-background-overlay" aria-hidden="true"></div>

    <div class="home-content">
<div class="home-shell mx-auto">
    <header class="home-header d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4 py-3 px-1">
        <a class="navbar-brand fw-bold text-white mb-0" asp-page="/Home">FaceFiles</a>
    </header>

    <div class="mb-4">
        <p class="text-uppercase small text-secondary mb-2 letter-spaced-sm">FaceFiles</p>
        <h1 class="h2 fw-semibold mb-2">People records in one place.</h1>
        <p class="mb-3 text-secondary">Search the names below, open a person, or add a new record.</p>
        <div class="d-flex flex-wrap gap-2">
            @* Add Person pre-ticks the folder you are currently viewing *@
            <a class="btn btn-outline-light" asp-page="/People/Create" asp-route-folder="@selectedId">Add Person</a>
            <div class="dropdown">
                <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-download me-1" aria-hidden="true"></i> Export &amp; backup
                </button>
                <ul class="dropdown-menu dropdown-menu-dark">
                    <li><a class="dropdown-item" asp-page-handler="ExportCsv"><i class="bi bi-filetype-csv me-2" aria-hidden="true"></i>Export CSV</a></li>
                    <li><a class="dropdown-item" asp-page-handler="ExportJson"><i class="bi bi-filetype-json me-2" aria-hidden="true"></i>Export JSON</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" asp-page-handler="BackupDatabase"><i class="bi bi-database-down me-2" aria-hidden="true"></i>Download database backup</a></li>
                </ul>
            </div>
            <form method="post" asp-page-handler="ImportCsv" enctype="multipart/form-data" id="importCsvForm">
                <input type="file" id="csvFile" name="csvFile" accept=".csv,text/csv" class="d-none" />
                <label for="csvFile" class="btn btn-outline-light">
                    <i class="bi bi-upload me-1" aria-hidden="true"></i>Import CSV
                </label>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ImportMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @Model.ImportMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* ===== Folder bar: "All" is automatic, the rest are created by you ===== *@
    <div class="mb-4">
        @* Grid: 4 folders per row on tablets/desktops (2 on phones); extra folders stack on new rows.
           Long names are cut off with "..." (hover to see the full name). *@
        @* Grid is half the page width on big screens; on narrow screens it never gets smaller than 420px (or the full width) *@
        <div class="row row-cols-2 row-cols-md-4 g-2" style="width: 50%; min-width: min(100%, 420px);">
            <div class="col">
                <a class="btn btn-sm w-100 text-truncate @(selectedId is null ? "btn-light" : "btn-outline-light")" asp-page="/Home" title="All people">All people (@Model.TotalCount)</a>
            </div>
            @foreach (var folder in Model.Folders)
            {
                <div class="col">
                    <a class="btn btn-sm w-100 text-truncate @(selectedId == folder.Id ? "btn-light" : "btn-outline-light")" asp-page="/Home" asp-route-folder="@folder.Id" title="@folder.Name">@folder.Name (@folder.PersonCount)</a>
                </div>
            }
        </div>

        <div class="folder-toolbar mt-3">
            <button type="button" class="add-detail-link" id="showFolderForm">+ New folder</button>

            @if (selectedId is not null)
            {
                <form method="post" asp-page-handler="DeleteFolder" onsubmit="return confirm('Delete this folder?');">
                    <input type="hidden" name="folderId" value="@selectedId" />
                    <button type="submit"
                            class="btn btn-sm btn-outline-danger folder-delete-button"
                            disabled="@(Model.SelectedFolderPersonCount > 0)"
                            title="@(Model.SelectedFolderPersonCount > 0 ? "Only empty folders can be deleted" : "Delete this folder")">
                        <i class="bi bi-trash3 me-1" aria-hidden="true"></i> Delete folder
                    </button>
                </form>
            }
        </div>

        @* Posts to OnPostCreateFolderAsync; Enter saves *@
        <form method="post" asp-page-handler="CreateFolder" class="add-detail-form d-none" id="folderForm">
            <div class="input-group">
                <input name="folderName" class="form-control" placeholder="Folder name (e.g. College), then press Enter" maxlength="100" aria-label="New folder name" />
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.FolderError))
        {
            <div class="text-warning small mt-2">@Model.FolderError</div>
        }
    </div>

    <div class="mb-4">
        <form class="home-search-form-simple" id="homeSearchForm">
            <div class="input-group">
                <input type="search" name="search" value="@Model.SearchTerm" class="form-control" id="homeSearchInput" placeholder="Search users..." aria-label="Search users" />
                <button class="btn btn-light" type="submit">Search</button>
            </div>
        </form>
    </div>

    <div class="mt-5">
        <div class="mb-3">
            <h2 class="h4 mb-0">@(Model.SelectedFolderName ?? "All people")</h2>
        </div>

        @if (Model.AlphabeticalPeople.Count == 0)
        {
            <p class="text-secondary mb-0">@(selectedId is not null ? "This folder is empty." : "No users found.")</p>
        }
        else
        {
            @foreach (var group in Model.AlphabeticalPeople.GroupBy(person =>
                string.IsNullOrWhiteSpace(person.FirstName) ? "#" : person.FirstName[..1].ToUpperInvariant()))
            {
                <section class="alphabet-group mb-4" data-search-group>
                    <h3 class="alphabet-heading h5 mb-2">@group.Key</h3>
                    <ul class="list-unstyled home-directory-list mb-0">
                        @foreach (var person in group)
                        {
                            <li class="home-directory-row py-2" data-search-person="@($"{person.FirstName} {person.LastName}")">
                                <a class="text-decoration-none text-white" asp-page="/People/Details" asp-route-id="@person.Id">
                                    @person.FirstName @person.LastName
                                </a>
                                @* In the "All" view, show every folder the person is in *@
                                @if (selectedId is null && Model.PersonFolderNames.TryGetValue(person.Id, out var personFolders))
                                {
                                    <span class="text-secondary small ms-2">@string.Join(", ", personFolders)</span>
                                }
                            </li>
                        }
                    </ul>
                </section>
            }
            <p class="text-secondary mb-0 d-none" id="noSearchResults">No users match your search.</p>
        }
    </div>
</div>
</div>
</div>

@section Scripts {
    <script>
        // "+ New folder": reveal the form and focus the input
        document.getElementById('showFolderForm')?.addEventListener('click', () => {
            document.getElementById('folderForm')?.classList.remove('d-none');
            document.getElementById('showFolderForm')?.classList.add('d-none');
            document.querySelector('#folderForm input[name="folderName"]')?.focus();
        });

        const searchInput = document.getElementById('homeSearchInput');
        const searchForm = document.getElementById('homeSearchForm');
        const searchPeople = () => {
            const term = searchInput?.value.trim().toLocaleLowerCase() ?? '';
            const groups = document.querySelectorAll('[data-search-group]');
            let visiblePeople = 0;

            groups.forEach(group => {
                let visibleInGroup = 0;
                group.querySelectorAll('[data-search-person]').forEach(person => {
                    const matches = person.dataset.searchPerson?.toLocaleLowerCase().includes(term) ?? false;
                    person.classList.toggle('d-none', !matches);
                    visibleInGroup += matches ? 1 : 0;
                });
                group.classList.toggle('d-none', visibleInGroup === 0);
                visiblePeople += visibleInGroup;
            });

            document.getElementById('noSearchResults')?.classList.toggle('d-none', visiblePeople > 0);
        };

        searchInput?.addEventListener('input', searchPeople);
        searchForm?.addEventListener('submit', event => event.preventDefault());
        document.getElementById('csvFile')?.addEventListener('change', () => {
            if (document.getElementById('csvFile')?.files?.length) {
                document.getElementById('importCsvForm')?.submit();
            }
        });
        searchPeople();
    </script>
}
