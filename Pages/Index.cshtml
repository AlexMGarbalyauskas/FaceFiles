@page
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Launch";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FaceFiles</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell app-shell-launch">
    <main class="app-main app-main-launch">
        <div class="launch-screen d-flex align-items-center justify-content-center min-vh-100">
            <div class="text-center px-3">
                <p class="text-uppercase text-secondary small letter-spaced mb-3">FaceFiles</p>
                <h1 class="display-6 fw-bold mb-4">Start your records experience</h1>
                <button type="button" class="btn btn-light btn-lg px-5 py-3 launch-button" id="launchButton">Open Face Files</button>
            </div>
        </div>

        <div class="loader-overlay d-none" id="loaderOverlay" aria-hidden="true">
            <div class="loader-panel text-center">
                <div class="spinner-border text-light mb-3" role="status" aria-label="Loading"></div>
                <div class="fw-semibold">Opening Face Files</div>
                <div class="text-secondary small mt-1">Loading your home page...</div>
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const button = document.getElementById('launchButton');
            const overlay = document.getElementById('loaderOverlay');

            button.addEventListener('click', () => {
                overlay.classList.remove('d-none');
                button.disabled = true;
                window.setTimeout(() => {
                    window.location.href = '/Home';
                }, 1200);
            });
        })();
    </script>
</body>
</html>
