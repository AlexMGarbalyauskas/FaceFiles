@page "{id:int}"
@model FaceFiles.Pages.People.EditModel
@{
    ViewData["Title"] = "Edit Person";
}

<h1 class="h3 mb-4">Edit Person</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Person.Id" />
            <input type="hidden" asp-for="Person.PhotoPath" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Person.FirstName" class="form-label"></label>
                    <input asp-for="Person.FirstName" class="form-control" />
                    <span asp-validation-for="Person.FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Person.LastName" class="form-label"></label>
                    <input asp-for="Person.LastName" class="form-control" />
                    <span asp-validation-for="Person.LastName" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Person.Details" class="form-label"></label>
                    <textarea asp-for="Person.Details" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Person.Details" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="PhotoUpload" class="form-label">Replace Photo</label>
                    <input asp-for="PhotoUpload" type="file" class="form-control" accept="image/*" />
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Person.PhotoPath))
                {
                    <div class="col-12">
                        <p class="mb-2">Current photo:</p>
                        <img src="@Model.Person.PhotoPath" alt="@Model.Person.FirstName @Model.Person.LastName" class="person-photo" />
                    </div>
                }
            </div>
            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Save Changes</button>
                <a class="btn btn-outline-secondary" asp-page="List">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
