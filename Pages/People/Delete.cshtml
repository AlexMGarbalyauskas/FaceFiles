@page "{id:int}"
@model FaceFiles.Pages.People.DeleteModel
@{
    ViewData["Title"] = "Delete Person";
}

@if (Model.Person is null)
{
    <div class="alert alert-warning">Person not found.</div>
}
else
{
    <div class="delete-page">
        <div class="delete-confirmation">
            <div class="delete-icon" aria-hidden="true">
                <i class="bi bi-trash3"></i>
            </div>
            <p class="text-uppercase small text-secondary letter-spaced-sm mb-2">FaceFiles</p>
            <h1 class="h3 mb-3">Delete this person?</h1>
            <p class="text-secondary mb-4">This will permanently remove <strong class="text-light">@Model.Person.FirstName @Model.Person.LastName</strong>.</p>
            <form method="post">
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <button class="btn btn-danger px-4" type="submit">Delete Person</button>
                    <a class="btn btn-outline-light px-4" asp-page="Details" asp-route-id="@Model.Person.Id">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}
