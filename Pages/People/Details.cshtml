@page "{id:int}"
@model FaceFiles.Pages.People.DetailsModel
@{
    ViewData["Title"] = "Person Details";
}

@* Guard: show a message if no person matches the id *@
@if (Model.Person is null)
{
    <div class="alert alert-warning">Person not found.</div>
}
else
{
    // Display name, and initials used as a photo placeholder
    var fullName = $"{Model.Person.FirstName} {Model.Person.LastName}".Trim();
    var initials = string.Concat(
        string.IsNullOrWhiteSpace(Model.Person.FirstName) ? string.Empty : Model.Person.FirstName[..1],
        string.IsNullOrWhiteSpace(Model.Person.LastName) ? string.Empty : Model.Person.LastName[..1]).ToUpperInvariant();

    <div class="detail-page-shell">
        @* Looping background video + dark overlay behind the content *@
        <video class="detail-background-video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
            <source src="~/videos/background.mp4" type="video/mp4" />
        </video>
        <div class="detail-background-overlay" aria-hidden="true"></div>
        <div class="detail-page-content">
        <div class="detail-back-box">
            <a class="btn btn-outline-light" asp-page="/Home">Back Home</a>
        </div>

        <div class="detail-card">
        @* Opens the delete confirmation modal (script at the bottom) *@
        <button type="button" class="detail-delete-button" id="showDeleteModal" title="Delete person" aria-label="Delete person">
            <i class="bi bi-trash3" aria-hidden="true"></i>
        </button>

        @* ===== Header: photo (or initials fallback) + name ===== *@
        <div class="detail-header">
            <div class="detail-photo-wrap" id="photoHolder">
                @if (string.IsNullOrWhiteSpace(Model.Person.PhotoPath))
                {
                    <div class="detail-photo-placeholder" aria-label="No photo">@initials</div>
                }
                else
                {
                    @* If the image fails to load, hide it and show the initials placeholder instead *@
                    <img class="detail-photo" src="@Model.Person.PhotoPath" alt="@fullName" onerror="this.classList.add('d-none'); this.nextElementSibling.classList.remove('d-none');" />
                    <div class="detail-photo-placeholder d-none" aria-label="No photo">@initials</div>
                }
                @* Hidden upload form: right-click photo -> "Add photo" -> file picker -> auto-submit.
                   Posts to OnPostAddPhotoAsync *@
                <form method="post" enctype="multipart/form-data" asp-page-handler="AddPhoto" id="photoForm" class="d-none">
                    <input type="file" id="photoUpload" name="PhotoUpload" accept="image/*" />
                </form>
                <div class="photo-context-menu d-none" id="photoContextMenu">
                    <button type="button" id="addPhotoButton">Add photo</button>
                </div>
            </div>
            <div class="detail-identity">
                <p class="detail-eyebrow">PERSON PROFILE</p>
                <h1 class="detail-name">@fullName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Person.Title))
                {
                    <p class="detail-role">@Model.Person.Title</p>
                }
            </div>
        </div>

        <div class="detail-divider"></div>

        <div class="detail-fields">
            @* ===== Title (NEW): view/edit pattern. Posts to OnPostUpdateTitleAsync ===== *@
            <div class="detail-field">
                <span class="detail-label">Title</span>
                <div class="editable-view">
                    <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Person.Title) ? "Not provided" : Model.Person.Title)</span>
                    <button type="button" class="detail-edit-trigger" data-edit-target="titleForm" title="Edit title" aria-label="Edit title">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                </div>
                <form method="post" asp-page-handler="UpdateTitle" class="inline-edit-form d-none" id="titleForm">
                    <div class="input-group">
                        <input name="NewTitle" class="form-control" value="@Model.Person.Title" placeholder="Title (e.g. Dr, Manager)" maxlength="100" aria-label="Edit title and press Enter to confirm" />
                    </div>
                </form>
            </div>

            @* ===== Folders: tick as many as you like, then save. Posts to OnPostUpdateFoldersAsync.
               Unticking everything removes the person from all folders; they always stay in "All people". ===== *@
            <div class="detail-field">
                <span class="detail-label">Folders</span>
                <div class="editable-view">
                    <span class="detail-value">@(Model.Folders.Any(item => Model.MemberFolderIds.Contains(item.Id))
                        ? string.Join(", ", Model.Folders.Where(item => Model.MemberFolderIds.Contains(item.Id)).Select(item => item.Name))
                        : "No folders")</span>
                    <button type="button" class="detail-edit-trigger" data-edit-target="folderForm" title="Change folders" aria-label="Change folders">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                </div>
                <form method="post" asp-page-handler="UpdateFolders" class="inline-edit-form d-none" id="folderForm">
                    @if (Model.Folders.Count == 0)
                    {
                        <span class="text-secondary small">No folders yet. Create one on the Home page.</span>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-3 mb-2">
                            @foreach (var folder in Model.Folders)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedFolderIds" value="@folder.Id" id="folder-@folder.Id" checked="@(Model.MemberFolderIds.Contains(folder.Id))" />
                                    <label class="form-check-label" for="folder-@folder.Id">@folder.Name</label>
                                </div>
                            }
                        </div>
                        <button type="submit" class="btn btn-sm btn-outline-light">Save folders</button>
                    }
                </form>
            </div>

            @* ===== Surname: view/edit pattern. Posts to OnPostUpdateSurnameAsync ===== *@
            <div class="detail-field">
                <span class="detail-label">Surname</span>
                <div class="editable-view">
                    <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Person.LastName) ? "Not provided" : Model.Person.LastName)</span>
                    <button type="button" class="detail-edit-trigger" data-edit-target="surnameForm" title="Edit surname" aria-label="Edit surname">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                </div>
                <form method="post" asp-page-handler="UpdateSurname" class="inline-edit-form d-none" id="surnameForm">
                    <div class="input-group">
                        <input name="NewSurname" class="form-control" value="@Model.Person.LastName" placeholder="Surname" aria-label="Edit surname and press Enter to confirm" />
                    </div>
                </form>
            </div>

            @* ===== Date of birth: view/edit pattern. Posts to OnPostUpdateDateOfBirthAsync =====
               FIX: a date input has no reliable Enter-to-submit, so this form now has an explicit
               Save button (a real submit button) plus a keydown handler in the script below. *@
            <div class="detail-field">
                <span class="detail-label">Date of Birth</span>
                <div class="editable-view">
                    <span class="detail-value">@(Model.Person.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not provided")</span>
                    <button type="button" class="detail-edit-trigger" data-edit-target="dateOfBirthForm" title="Edit date of birth" aria-label="Edit date of birth">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                </div>
                <form method="post" asp-page-handler="UpdateDateOfBirth" class="inline-edit-form d-none" id="dateOfBirthForm">
                    <div class="input-group">
                        <input type="date" name="NewDateOfBirth" class="form-control" value="@(Model.Person.DateOfBirth?.ToString("yyyy-MM-dd"))" max="@DateTime.Today.ToString("yyyy-MM-dd")" aria-label="Edit date of birth and press Enter or Save to confirm" />
                        <button type="submit" class="btn btn-outline-light" title="Save date of birth" aria-label="Save date of birth">
                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                </form>
            </div>

            <div class="detail-contact-panel">
                <div class="detail-section-heading">
                    <div>
                        <p class="detail-eyebrow">DIRECT CONTACT</p>
                        <h2 class="detail-label">Contact information</h2>
                    </div>
                    <button type="button" class="detail-edit-trigger" data-edit-target="contactForm" title="Edit contact information" aria-label="Edit contact information">
                        <i class="bi bi-pencil" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="contact-grid editable-view" data-edit-view="contactForm">
                    <div class="contact-item">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <div>
                            <span class="contact-label">Email</span>
                            @if (string.IsNullOrWhiteSpace(Model.Person.Email))
                            {
                                <span class="detail-value">Not provided</span>
                            }
                            else
                            {
                                <a class="contact-value" href="mailto:@Model.Person.Email">@Model.Person.Email</a>
                            }
                        </div>
                    </div>
                    <div class="contact-item">
                        <i class="bi bi-telephone" aria-hidden="true"></i>
                        <div>
                            <span class="contact-label">Phone</span>
                            @if (string.IsNullOrWhiteSpace(Model.Person.PhoneNumber))
                            {
                                <span class="detail-value">Not provided</span>
                            }
                            else
                            {
                                <a class="contact-value" href="tel:@Model.Person.PhoneNumber">@Model.Person.PhoneNumber</a>
                            }
                        </div>
                    </div>
                </div>
                <form method="post" asp-page-handler="UpdateContact" class="inline-edit-form d-none" id="contactForm">
                    <div class="contact-edit-grid">
                        <div>
                            <label class="form-label" for="newEmail">Email</label>
                            <input id="newEmail" name="NewEmail" type="email" class="form-control" value="@Model.Person.Email" placeholder="name@example.com" maxlength="254" />
                        </div>
                        <div>
                            <label class="form-label" for="newPhoneNumber">Phone number</label>
                            <input id="newPhoneNumber" name="NewPhoneNumber" type="tel" class="form-control" value="@Model.Person.PhoneNumber" placeholder="+1 555 123 4567" maxlength="50" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-sm btn-outline-light mt-3">Save contact information</button>
                </form>
            </div>
        </div>

        @* ===== Bio: click text to swap for a textarea. Posts to OnPostUpdateBioAsync ===== *@
        <div class="detail-bio">
            <h2 class="detail-label">Bio</h2>
            <div class="bio-display editable-view" data-edit-target="bioForm" role="button" tabindex="0">
                <span class="detail-text">@(string.IsNullOrWhiteSpace(Model.Person.Details) ? "No bio entered." : Model.Person.Details)</span>
            </div>
            <form method="post" asp-page-handler="UpdateBio" class="inline-edit-form d-none" id="bioForm">
                <textarea name="NewBio" class="form-control" rows="4" placeholder="Write a bio" aria-label="Bio. Press Enter to save or Shift and Enter for a new line">@Model.Person.Details</textarea>
                <button type="submit" class="btn btn-sm btn-outline-light mt-2">Save bio</button>
            </form>
        </div>

        @* ===== Personality evaluation: Enter saves; Shift+Enter creates a new line ===== *@
        <div class="detail-personality">
            <div class="detail-section-heading">
                <div>
                    <p class="detail-eyebrow">OBSERVATION</p>
                    <h2 class="detail-label">Personality evaluation</h2>
                </div>
            </div>
            <div class="bio-display editable-view" data-edit-target="personalityForm" role="button" tabindex="0">
                <span class="detail-text">@(string.IsNullOrWhiteSpace(Model.Person.PersonalityEvaluation) ? "No personality evaluation entered." : Model.Person.PersonalityEvaluation)</span>
                <button type="button" class="detail-edit-trigger" title="Edit personality evaluation" aria-label="Edit personality evaluation">
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                </button>
            </div>
            <form method="post" asp-page-handler="UpdatePersonality" class="inline-edit-form d-none" id="personalityForm">
                <textarea name="NewPersonalityEvaluation" class="form-control" rows="5" maxlength="2000" placeholder="Write an objective evaluation..." aria-label="Personality evaluation. Press Enter to save or Shift and Enter for a new line">@Model.Person.PersonalityEvaluation</textarea>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <button type="submit" class="btn btn-sm btn-outline-light">Save evaluation</button>
                    <span class="text-secondary small">Enter saves; Shift+Enter adds a new line.</span>
                </div>
            </form>
        </div>

        @* ===== Additional details: one edit form per list item ===== *@
        <div class="detail-additional">
            <h2 class="detail-label">Additional details</h2>
            @if (Model.Person.AdditionalDetails.Count > 0)
            {
                <ul class="detail-list">
                    @for (var detailIndex = 0; detailIndex < Model.Person.AdditionalDetails.Count; detailIndex++)
                    {
                        var detail = Model.Person.AdditionalDetails[detailIndex];
                        var detailFormId = $"additionalDetailForm-{detailIndex}";

                        <li class="additional-detail-row">
                            <div class="editable-view">
                                <span class="detail-value">@detail</span>
                                <button type="button" class="detail-edit-trigger" data-edit-target="@detailFormId" title="Edit detail" aria-label="Edit detail">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </div>
                            <form method="post" asp-page-handler="UpdateDetail" class="inline-edit-form d-none" id="@detailFormId">
                                @* Tells the server which list item to update *@
                                <input type="hidden" name="DetailIndex" value="@detailIndex" />
                                <div class="input-group">
                                    <input name="EditedDetail" class="form-control" value="@detail" aria-label="Edit detail and press Enter to confirm" />
                                </div>
                            </form>
                        </li>
                    }
                </ul>
            }

            <button type="button" class="add-detail-link" id="showDetailForm">+ Add detail</button>
            <form method="post" asp-page-handler="AddDetail" class="add-detail-form d-none" id="detailForm">
                <label for="newDetail" class="visually-hidden">Additional detail</label>
                <div class="input-group">
                    <input id="newDetail" name="NewDetail" class="form-control" placeholder="Write additional information, then press Enter" />
                </div>
            </form>
        </div>

        @* ===== Social links: show an embedded preview where the platform allows iframe embedding ===== *@
        <div class="detail-social">
            <h2 class="detail-label">Social media</h2>
            @if (Model.Person.SocialLinks.Count > 0)
            {
                <div class="social-link-list">
                    @foreach (var socialLink in Model.Person.SocialLinks)
                    {
                        <article class="social-card">
                            <div class="social-card-header">
                                <span class="social-link">
                                    <i class="bi bi-link-45deg" aria-hidden="true"></i>
                                    <span>@socialLink.Platform</span>
                                </span>
                                <a class="social-open-link" href="@socialLink.Url" target="_blank" rel="noopener noreferrer">
                                    Open
                                </a>
                            </div>
                            @if (socialLink.Platform.Contains("facebook", StringComparison.OrdinalIgnoreCase))
                            {
                                <iframe class="social-embed social-embed-facebook"
                                        src="https://www.facebook.com/plugins/page.php?href=@Uri.EscapeDataString(socialLink.Url)&tabs=timeline&width=500&height=500"
                                        title="@socialLink.Platform preview"
                                        loading="lazy"
                                        referrerpolicy="no-referrer"
                                        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>
                            }
                            else if (socialLink.Platform.Contains("twitter", StringComparison.OrdinalIgnoreCase)
                                || socialLink.Platform.Equals("x", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="social-official-widget">
                                    <a class="twitter-timeline"
                                       data-height="360"
                                       href="@socialLink.Url">View @socialLink.Platform</a>
                                </div>
                            }
                            else
                            {
                                <div class="social-profile-fallback">
                                    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                    <strong>@socialLink.Platform profile</strong>
                                    <span>This platform does not allow profile previews inside other websites.</span>
                                    <a href="@socialLink.Url" target="_blank" rel="noopener noreferrer">View profile on @socialLink.Platform</a>
                                </div>
                            }
                        </article>
                    }
                </div>
            }

            <button type="button" class="add-detail-link" id="showSocialForm">+ Add social link</button>
            <form method="post" asp-page-handler="AddSocialLink" class="add-social-form d-none" id="socialForm">
                <div class="social-inputs">
                    <input name="NewSocialPlatform" class="form-control" placeholder="Facebook, Instagram..." aria-label="Social platform" required />
                    <input name="NewSocialUrl" type="url" class="form-control" placeholder="https://..." aria-label="Social media URL" required />
                </div>
                <button type="submit" class="btn btn-sm btn-outline-light mt-2">Save link</button>
            </form>
        </div>

        <button type="button" class="ai-assistant-toggle" id="aiAssistantToggle" aria-controls="aiAssistantPanel" aria-expanded="false">
            <i class="bi bi-stars" aria-hidden="true"></i>
            <span>AI assistant</span>
        </button>

        <aside class="ai-assistant-panel" id="aiAssistantPanel" aria-label="AI profile assistant" aria-hidden="true">
            <div class="ai-assistant-header">
                <div>
                    <p class="detail-eyebrow">PROFILE ANALYSIS</p>
                    <h2>AI assistant</h2>
                </div>
                <button type="button" class="ai-assistant-close" id="aiAssistantClose" aria-label="Close AI assistant">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <div class="ai-assistant-messages" id="aiAssistantMessages">
                <div class="ai-message ai-message-assistant ai-message-welcome">
                    <i class="bi bi-stars ai-welcome-icon" aria-hidden="true"></i>
                    <span>Ask about key traits, communication style, or a balanced profile summary.</span>
                </div>
            </div>
            <form class="ai-assistant-form" id="aiAssistantForm">
                @Html.AntiForgeryToken()
                <textarea id="aiAssistantInput" name="message" rows="2" maxlength="2000" placeholder="Ask about this person..." aria-label="Ask the AI assistant"></textarea>
                <button type="submit" class="btn btn-light" id="aiAssistantSend">
                    <i class="bi bi-send" aria-hidden="true"></i>
                    Send
                </button>
                <p class="ai-assistant-status text-secondary small" id="aiAssistantStatus"></p>
            </form>
        </aside>

        </div>
        </div>

        @* ===== Delete confirmation modal. Posts to OnPostDeletePersonAsync ===== *@
        <div class="delete-modal d-none" id="deleteModal" role="dialog" aria-modal="false" aria-labelledby="deleteModalTitle">
            <div class="delete-confirmation">
                <div class="delete-icon" aria-hidden="true">
                    <i class="bi bi-trash3"></i>
                </div>
                <h2 class="h4 mb-3" id="deleteModalTitle">Delete this person?</h2>
                <p class="text-secondary mb-4">This will permanently remove <strong class="text-light">@fullName</strong>.</p>
                <form method="post" asp-page-handler="DeletePerson">
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <button class="btn btn-danger px-4" type="submit">Delete Person</button>
                        <button class="btn btn-outline-light px-4" type="button" id="cancelDelete">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Generic edit toggle: any element with data-edit-target hides its view
        // and shows the form whose id matches the attribute value.
        document.querySelectorAll('[data-edit-target]').forEach((button) => {
            button.addEventListener('click', () => {
                const form = document.getElementById(button.dataset.editTarget);
                form?.classList.remove('d-none');
                (button.closest('.editable-view')
                    ?? document.querySelector(`[data-edit-view="${button.dataset.editTarget}"]`))?.classList.add('d-none');
                form?.querySelector('input, textarea, select')?.focus();
            });
        });

        const aiToggle = document.getElementById('aiAssistantToggle');
        const aiPanel = document.getElementById('aiAssistantPanel');
        const aiClose = document.getElementById('aiAssistantClose');
        const aiForm = document.getElementById('aiAssistantForm');
        const aiInput = document.getElementById('aiAssistantInput');
        const aiMessages = document.getElementById('aiAssistantMessages');
        const aiStatus = document.getElementById('aiAssistantStatus');
        const aiSend = document.getElementById('aiAssistantSend');
        const aiHistory = [];

        const setAiPanelOpen = (isOpen) => {
            aiPanel?.classList.toggle('is-open', isOpen);
            aiPanel?.setAttribute('aria-hidden', (!isOpen).toString());
            aiToggle?.setAttribute('aria-expanded', isOpen.toString());
            if (isOpen) {
                aiInput?.focus();
            }
        };

        aiToggle?.addEventListener('click', () => setAiPanelOpen(true));
        aiClose?.addEventListener('click', () => setAiPanelOpen(false));

        const addAiMessage = (content, role) => {
            const message = document.createElement('div');
            message.className = `ai-message ai-message-${role}`;
            message.textContent = content;
            aiMessages?.appendChild(message);
            aiMessages?.scrollTo({ top: aiMessages.scrollHeight, behavior: 'smooth' });
        };

        aiInput?.addEventListener('keydown', event => {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                aiForm?.requestSubmit();
            }
        });

        aiForm?.addEventListener('submit', async event => {
            event.preventDefault();
            const message = aiInput.value.trim();
            if (!message || aiSend.disabled) {
                return;
            }

            addAiMessage(message, 'user');
            aiHistory.push({ role: 'user', content: message });
            aiInput.value = '';
            aiSend.disabled = true;
            aiStatus.textContent = 'Analyzing profile...';

            try {
                const body = new URLSearchParams({
                    message,
                    history: JSON.stringify(aiHistory.slice(-12)),
                    __RequestVerificationToken: aiForm.querySelector('input[name="__RequestVerificationToken"]').value
                });
                const response = await fetch('?handler=Chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body
                });
                const result = await response.json();
                if (!response.ok) {
                    throw new Error(result.detail || result.error || 'The assistant could not answer.');
                }

                addAiMessage(result.answer, 'assistant');
                aiHistory.push({ role: 'assistant', content: result.answer });
                aiStatus.textContent = '';
            } catch (error) {
                aiStatus.textContent = error.message;
            } finally {
                aiSend.disabled = false;
                aiInput.focus();
            }
        });

        // Text evaluations: Enter submits, Shift+Enter inserts a newline.
        document.querySelectorAll('textarea[name="NewBio"], textarea[name="NewPersonalityEvaluation"]').forEach(textarea => {
            textarea.addEventListener('keydown', event => {
                if (event.key === 'Enter' && !event.shiftKey) {
                    event.preventDefault();
                    event.currentTarget.form.requestSubmit();
                }
            });
        });

        // Date of birth (FIX): date inputs don't reliably submit on Enter, so submit explicitly.
        // requestSubmit() is used (instead of submit()) so the browser validates the date first.
        document.querySelector('input[name="NewDateOfBirth"]')?.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
                event.preventDefault();
                event.currentTarget.form.requestSubmit();
            }
        });

        // Add detail: reveal the form and focus the input
        document.getElementById('showDetailForm')?.addEventListener('click', () => {
            document.getElementById('detailForm')?.classList.remove('d-none');
            document.getElementById('showDetailForm')?.classList.add('d-none');
            document.getElementById('newDetail')?.focus();
        });

        // Add social link: reveal the form and focus the platform input
        document.getElementById('showSocialForm')?.addEventListener('click', () => {
            document.getElementById('socialForm')?.classList.remove('d-none');
            document.getElementById('showSocialForm')?.classList.add('d-none');
            document.querySelector('input[name="NewSocialPlatform"]')?.focus();
        });

        // Social link: Enter in either field submits after native validation.
        const socialForm = document.getElementById('socialForm');
        socialForm?.querySelectorAll('input').forEach(input => {
            input.addEventListener('keydown', event => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    socialForm.requestSubmit();
                }
            });
        });

        if (document.querySelector('.twitter-timeline')) {
            const twitterScript = document.createElement('script');
            twitterScript.src = 'https://platform.twitter.com/widgets.js';
            twitterScript.async = true;
            document.body.appendChild(twitterScript);
        }

        // Photo: right-click shows a small menu at the cursor; choosing a file auto-submits
        const photoHolder = document.getElementById('photoHolder');
        const photoMenu = document.getElementById('photoContextMenu');
        const photoForm = document.getElementById('photoForm');
        const photoUpload = document.getElementById('photoUpload');

        photoHolder?.addEventListener('contextmenu', (event) => {
            event.preventDefault();
            photoMenu?.classList.remove('d-none');
            photoMenu.style.left = `${event.offsetX}px`;
            photoMenu.style.top = `${event.offsetY}px`;
        });

        document.getElementById('addPhotoButton')?.addEventListener('click', () => {
            photoUpload?.click();
            photoMenu?.classList.add('d-none');
        });

        photoUpload?.addEventListener('change', () => {
            if (photoUpload.files.length > 0) {
                photoForm.submit();
            }
        });

        // Clicking anywhere else closes the photo menu
        document.addEventListener('click', () => photoMenu?.classList.add('d-none'));
        photoMenu?.addEventListener('click', (event) => event.stopPropagation());

        // Delete modal: open, cancel, or click the backdrop to close
        const deleteModal = document.getElementById('deleteModal');
        document.getElementById('showDeleteModal')?.addEventListener('click', () => {
            deleteModal?.classList.remove('d-none');
        });

        document.getElementById('cancelDelete')?.addEventListener('click', () => {
            deleteModal?.classList.add('d-none');
        });

        deleteModal?.addEventListener('click', (event) => {
            if (event.target === deleteModal) {
                deleteModal.classList.add('d-none');
            }
        });
    </script>
}
